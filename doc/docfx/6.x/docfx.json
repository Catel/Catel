{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/**/*.cs"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "src/projects/**"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "toc.yml",
          "*.md"
        ],
        "src": ".",
        "dest": "."
      },
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "src": ".",
        "dest": "."
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "css/**",
          "downloads/**"
        ],
        "src": ".",
        "dest": "."
      }
    ],
    "output": "../../site/6.x",
    "template": [
      "default"
    ],
    "globalMetadata": {
      "_appTitle": "Catel Documentation - 6.x",
      "_appFooter": "Catel is an application development platform with the focus on MVVM.",
      "_gitContribute": {
        "repo": "https://github.com/catel/catel",
        "branch": "master",
        "apiSpecFolder": "doc/docfx/6.x"
      },
      "_gitUrlPattern": "github",
      "_enableSearch": true,
      "_disableContribution": false
    },
    "sitemap": {
      "baseUrl": "https://docs.catelproject.com/6.x/"
    }
  }
}
